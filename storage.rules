rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isImage() { return request.resource.contentType.matches('image/.*'); }
    function below5Mb() { return request.resource.size < 5 * 1024 * 1024; }

    match /users/{uid}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid && isImage() && below5Mb();
    }
    match /products/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid && isImage() && below5Mb();
    }
    match /services/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid && isImage() && below5Mb();
    }
    match /content/{allPaths=**} { allow read: if true; allow write: if admin() && isImage() && below5Mb(); }
    match /config/{allPaths=**} { allow read: if true; allow write: if admin() && isImage() && below5Mb(); }
  }
}
